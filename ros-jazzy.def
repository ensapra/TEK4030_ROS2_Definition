Bootstrap: docker
From: ubuntu:24.04

%labels
    Author ROS 2 Jazzy Apptainer
    ROS_Distro jazzy
    Ubuntu_Version 24.04

%help
    ROS 2 Jazzy on Ubuntu 24.04, installed from the official ROS 2 apt repository.

%environment
    export LANG=en_US.UTF-8
    export LC_ALL=en_US.UTF-8

    export ROS_VERSION=2
    export ROS_DISTRO=jazzy
    export ROS_PYTHON_VERSION=3

	export PS1='APPT \w\$ '

    # Load the complete ROS 2 environment
    if [ -f /opt/ros/jazzy/setup.sh ]; then
        . /opt/ros/jazzy/setup.sh
    fi

%post
    export DEBIAN_FRONTEND=noninteractive

    # ------------------------------------------------------------
    # Locale
    # ------------------------------------------------------------

    apt-get update

    apt-get install -y \
        locales \
        software-properties-common \
        curl \
        ca-certificates

    locale-gen en_US en_US.UTF-8

    update-locale \
        LC_ALL=en_US.UTF-8 \
        LANG=en_US.UTF-8

    export LANG=en_US.UTF-8
    export LC_ALL=en_US.UTF-8

    # ------------------------------------------------------------
    # Enable Ubuntu Universe
    # ------------------------------------------------------------

    add-apt-repository universe

    # ------------------------------------------------------------
    # Add official ROS 2 apt repository
    # ------------------------------------------------------------

    apt-get update
    apt-get install -y curl

    export ROS_APT_SOURCE_VERSION=$(
        curl -s https://api.github.com/repos/ros-infrastructure/ros-apt-source/releases/latest \
        | grep -F "tag_name" \
        | awk -F'"' '{print $4}'
    )

    curl -L \
        -o /tmp/ros2-apt-source.deb \
        "https://github.com/ros-infrastructure/ros-apt-source/releases/download/${ROS_APT_SOURCE_VERSION}/ros2-apt-source_${ROS_APT_SOURCE_VERSION}.$(. /etc/os-release && echo ${UBUNTU_CODENAME:-${VERSION_CODENAME}})_all.deb"

    dpkg -i /tmp/ros2-apt-source.deb

    # ------------------------------------------------------------
    # Update apt repositories
    # ------------------------------------------------------------

    apt-get update
    apt-get upgrade -y

    # ------------------------------------------------------------
    # ROS 2 development tools
    # ------------------------------------------------------------

    apt-get install -y \
        ros-dev-tools

    # ------------------------------------------------------------
    # ROS 2 Jazzy Desktop
    #
    # Includes ROS, RViz, demos, tutorials, etc.
    # ------------------------------------------------------------

    apt-get install -y \
        ros-jazzy-desktop

    # ------------------------------------------------------------
    # Cleanup
    # ------------------------------------------------------------

    rm -f /tmp/ros2-apt-source.deb

    apt-get clean
    rm -rf /var/lib/apt/lists/*

%test
    echo "Testing ROS 2 Jazzy..."

    test -f /opt/ros/jazzy/setup.bash
    test -x /opt/ros/jazzy/bin/ros2

    . /opt/ros/jazzy/setup.sh

    test "$ROS_DISTRO" = "jazzy"

    ros2 --help > /dev/null

    echo "ROS 2 Jazzy installation OK."

%runscript
    if [ "$#" -eq 0 ]; then
        exec bash
    else
        exec "$@"
    fi

